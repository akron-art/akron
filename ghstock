function StatusBadge({ qty, par }) {
const pct = par > 0 ? (qty / par) * 100 : 100;
const [color, bg, label] =
pct >= 60 ? [C.green, “#E8F5EC”, “✓ OK”]      :
pct >= 30 ? [C.amber, “#FDF3E3”, “⚠ Low”]     :
[C.red,   “#FDECEA”, “✗ Critical”];
return (
<span style={{ background: bg, color, border: `1px solid ${color}`, borderRadius: 4, padding: “2px 8px”, fontSize: 11, fontWeight: 700, whiteSpace: “nowrap” }}>
{label}
</span>
);
}

