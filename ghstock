      <div style={{ fontWeight:700, color:C.charcoal, margin:"15px 0 8px", fontSize:14 }}>รายการทั้งหมด ({items.length})</div>
      {items.map(item => (
        <div key={item.id} style={{ ...card, padding:"10px 13px", display:"flex", justifyContent:"space-between", alignItems:"center" }}>
          <div style={{ flex:1, minWidth:0 }}>
            <div style={{ fontWeight:600, fontSize:13, overflow:"hidden", textOverflow:"ellipsis", whiteSpace:"nowrap" }}>{item.name}</div>
            <div style={{ fontSize:11, color:C.muted }}>{item.category} · PAR {item.par} {item.unit}</div>
          </div>
          <div style={{ display:"flex", gap:6, marginLeft:10, flexShrink:0 }}>
            <button style={{ background:"none", border:`1px solid ${C.blue}`, borderRadius:5, padding:"4px 9px", cursor:"pointer", color:C.blue, fontSize:12, fontWeight:600 }} onClick={()=>setEditItem(item)}>✏️ แก้ไข</button>
            <button style={{ background:"none", border:`1px solid ${C.border}`, borderRadius:5, padding:"4px 9px", cursor:"pointer", color:C.red, fontSize:12 }} onClick={()=>deleteItem(item)}>✕</button>
          </div>
        </div>
      ))}

      {/* Export */}
      <div style={{ ...card, marginTop:15, background:"#FAFAF7" }}>
        <div style={{ fontWeight:700, color:C.charcoal, marginBottom:11, fontSize:14 }}>📥 Export ข้อมูล</div>
        <div style={{ display:"flex", gap:10 }}>
          <button style={{ ...btn(C.green), flex:1 }} onClick={exportStockCSV}>⬇ Stock ปัจจุบัน (.csv)</button>
          <button style={{ ...btn(C.charcoal), flex:1 }} onClick={exportLogCSV}>⬇ ประวัติทั้งหมด (.csv)</button>
        </div>
        <div style={{ fontSize:11, color:C.muted, marginTop:8 }}>รองรับ Excel / Google Sheets · UTF-8 BOM (ภาษาไทยไม่แตก)</div>
      </div>
    </>)}

  </div>

  {/* ── Edit Modal ── */}
  {editItem && <EditModal item={editItem} onSave={saveEdit} onClose={()=>setEditItem(null)} />}

  {/* ── Toast ── */}
  {toastMsg && (
    <div style={{ position:"fixed", bottom:24, left:"50%", transform:"translateX(-50%)", background:C.charcoal, color:"#fff", padding:"10px 22px", borderRadius:8, fontSize:13, fontWeight:600, zIndex:999, boxShadow:"0 4px 20px rgba(0,0,0,0.3)", pointerEvents:"none" }}>
      {toastMsg}
    </div>
  )}
</div>
```

