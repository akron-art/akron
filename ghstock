export default function NokaStock() {
const [items, setItems] = useState(() => load(“noka_items”, INITIAL_ITEMS));
const [logs,  setLogs]  = useState(() => load(“noka_logs”,  []));
const [stock, setStock] = useState(() => load(“noka_stock”, null) ?? initStock(INITIAL_ITEMS));

const [view,       setView]       = useState(“dashboard”);
const [filterCat,  setFilterCat]  = useState(“All”);
const [checkDate,  setCheckDate]  = useState(todayStr());
const [checkQtys,  setCheckQtys]  = useState({});
const [newItem,    setNewItem]    = useState({ name: “”, category: “Ingredient”, unit: “pack”, par: 10 });
const [searchText, setSearchText] = useState(””);
const [toastMsg,   setToastMsg]   = useState(””);
const [editItem,   setEditItem]   = useState(null);

useEffect(() => {
try {
localStorage.setItem(“noka_items”, JSON.stringify(items));
localStorage.setItem(“noka_logs”,  JSON.stringify(logs));
localStorage.setItem(“noka_stock”, JSON.stringify(stock));
} catch {}
}, [items, logs, stock]);

const toast = (msg) => { setToastMsg(msg); setTimeout(() => setToastMsg(””), 2600); };

const dynCats      = [“All”, …new Set(items.map(i => i.category))];
const filteredItems = items.filter(i => {
const catOk    = filterCat === “All” || i.category === filterCat;
const searchOk = !searchText || i.name.toLowerCase().includes(searchText.toLowerCase());
return catOk && searchOk;
});

const pctOf  = (item) => item.par > 0 ? (stock[item.id] ?? 0) / item.par : 1;
const okCount       = items.filter(i => pctOf(i) >= 0.6).length;
const lowCount      = items.filter(i => pctOf(i) >= 0.3 && pctOf(i) < 0.6).length;
const criticalCount = items.filter(i => pctOf(i) < 0.3).length;
const getColor      = (qty, par) => { const p = par > 0 ? qty / par * 100 : 100; return p >= 60 ? C.green : p >= 30 ? C.amber : C.red; };

function submitCheck() {
const entries = Object.entries(checkQtys).filter(([, v]) => v !== “” && !isNaN(parseFloat(v)));
if (!entries.length) { toast(“กรุณากรอกจำนวนอย่างน้อย 1 รายการ”); return; }
const newLogs = []; const ns = { …stock };
entries.forEach(([id, qty]) => {
const numId = parseInt(id); const item = items.find(i => i.id === numId); if (!item) return;
const numQty = parseFloat(qty); const prev = ns[numId] ?? 0;
ns[numId] = numQty;
newLogs.push({ date: checkDate, itemId: numId, itemName: item.name, prev, qty: numQty, diff: numQty - prev, ts: Date.now() });
});
setStock(ns); setLogs(p => […newLogs, …p].slice(0, 500));
setCheckQtys({}); toast(`✓ บันทึก ${newLogs.length} รายการเรียบร้อย`); setView(“dashboard”);
}

function addItem() {
if (!newItem.name.trim()) { toast(“กรุณากรอกชื่อวัตถุดิบ”); return; }
const maxId = items.reduce((m, i) => Math.max(m, i.id), 0);
const item  = { …newItem, id: maxId + 1, name: newItem.name.trim() };
setItems(p => […p, item]); setStock(p => ({ …p, [item.id]: 0 }));
setNewItem({ name: “”, category: “Ingredient”, unit: “pack”, par: 10 });
toast(`✓ เพิ่ม "${item.name}" เรียบร้อย`);
}

function saveEdit(updated) {
setItems(p => p.map(i => i.id === updated.id ? updated : i));
setLogs(p => p.map(l => l.itemId === updated.id ? { …l, itemName: updated.name } : l));
setEditItem(null); toast(`✓ แก้ไข "${updated.name}" เรียบร้อย`);
}

function deleteItem(item) {
if (!window.confirm(`ลบ "${item.name}"?`)) return;
setItems(p => p.filter(i => i.id !== item.id));
setStock(p => { const n = { …p }; delete n[item.id]; return n; });
toast(`ลบ "${item.name}" เรียบร้อย`);
}

function downloadCSV(rows, filename) {
const bom = “\uFEFF”;
const csv = bom + rows.map(r => r.map(v => `"${String(v).replace(/"/g, '""')}"`).join(”,”)).join(”\n”);
const url = URL.createObjectURL(new Blob([csv], { type: “text/csv;charset=utf-8;” }));
const a = document.createElement(“a”); a.href = url; a.download = filename; a.click(); URL.revokeObjectURL(url);
}

function exportStockCSV() {
const header = [“ID”,“ชื่อ”,“หมวดหมู่”,“หน่วย”,“PAR Level”,“จำนวนปัจจุบัน”,”% ของ PAR”,“สถานะ”];
const rows   = items.map(i => {
const qty = stock[i.id] ?? 0; const pct = i.par > 0 ? ((qty/i.par)*100).toFixed(1) : “-”;
const st  = i.par > 0 ? (qty/i.par >= 0.6 ? “OK” : qty/i.par >= 0.3 ? “Low” : “Critical”) : “OK”;
return [i.id, i.name, i.category, i.unit, i.par, qty, pct, st];
});
downloadCSV([header, …rows], `noka_stock_${todayStr()}.csv`); toast(“✓ Export Stock CSV เรียบร้อย”);
}

function exportLogCSV() {
if (!logs.length) { toast(“ยังไม่มีประวัติ”); return; }
const header = [“วันที่”,“รายการ”,“ก่อน”,“หลัง”,“เปลี่ยน”];
const rows   = logs.map(l => [l.date, l.itemName, l.prev, l.qty, l.diff >= 0 ? `+${l.diff}` : l.diff]);
downloadCSV([header, …rows], `noka_log_${todayStr()}.csv`); toast(“✓ Export Log CSV เรียบร้อย”);
}

